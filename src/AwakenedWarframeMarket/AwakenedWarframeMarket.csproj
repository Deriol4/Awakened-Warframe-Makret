<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Tesseract ships native x64 DLLs; AnyCPU would also try to run as x86/ARM -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AwakenedWarframeMarket</AssemblyName>
    <RootNamespace>AwakenedWarframeMarket</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Deriol4</Authors>
    <Description>Warframe Market price checker overlay</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tessdata\eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
