<Window x:Class="AwakenedWarframeMarket.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AwakenedWarframeMarket.Services"
        Title="{x:Static l:L.Settings}"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Edge}"
            BorderThickness="1"
            TextElement.FontFamily="{StaticResource UiFont}"
            TextElement.FontSize="13"
            TextElement.Foreground="{StaticResource Text}">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top"
                    Height="36"
                    Background="{StaticResource TopBg}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource CaptionButton}"
                            ToolTip="{x:Static l:L.CloseWithoutSaving}"
                            AutomationProperties.Name="{x:Static l:L.Close}"
                            Click="CancelButton_Click">
                        <Path Data="M2,2 L10,10 M10,2 L2,10" Width="12" Height="12"
                              Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <TextBlock Text="{x:Static l:L.Settings}" FontSize="12" Foreground="{StaticResource Soft}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource FooterBg}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlineButton}" Content="{x:Static l:L.Cancel}" Margin="0,0,8,0" Click="CancelButton_Click"/>
                    <Button Style="{StaticResource AccentButton}" Content="{x:Static l:L.Save}" Click="SaveButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Body -->
            <StackPanel Margin="18,18,18,20">
                <TextBlock Text="{x:Static l:L.PriceCheckHotkey}" Foreground="{StaticResource TextStrong}"/>
                <TextBlock Text="{x:Static l:L.PriceCheckHotkeyHint}"
                           Style="{StaticResource Caption}" Margin="0,2,0,8" TextWrapping="Wrap"/>

                <Button x:Name="HotkeyBox"
                        Height="38"
                        HorizontalContentAlignment="Left"
                        Padding="12,0"
                        Background="{StaticResource InputBg}"
                        Click="HotkeyBox_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}"/>
                    </Button.Style>
                    <TextBlock x:Name="HotkeyBoxText" Text="Alt + X" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"/>
                </Button>
                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                <TextBlock Text="{x:Static l:L.SearchHotkey}" Foreground="{StaticResource TextStrong}" Margin="0,20,0,0"/>
                <TextBlock Text="{x:Static l:L.SearchHotkeyHint}"
                           Style="{StaticResource Caption}" Margin="0,2,0,8" TextWrapping="Wrap"/>

                <Button x:Name="SearchHotkeyBox"
                        Height="38"
                        HorizontalContentAlignment="Left"
                        Padding="12,0"
                        Background="{StaticResource InputBg}"
                        Click="SearchHotkeyBox_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}"/>
                    </Button.Style>
                    <TextBlock x:Name="SearchHotkeyBoxText" Text="Alt + F" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"/>
                </Button>
                <TextBlock x:Name="SearchHotkeyHint" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                <TextBlock Text="{x:Static l:L.InterfaceLanguage}" Foreground="{StaticResource TextStrong}" Margin="0,20,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UiEnglishButton" Style="{StaticResource OutlineButton}" Content="English" MinWidth="96" Margin="0,0,8,0" Click="UiLanguage_Click"/>
                    <Button x:Name="UiRussianButton" Style="{StaticResource OutlineButton}" Content="Русский" MinWidth="96" Click="UiLanguage_Click"/>
                </StackPanel>
                <TextBlock x:Name="UiLanguageHint" Text="{x:Static l:L.InterfaceLanguageHint}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="Collapsed"/>

                <TextBlock Text="{x:Static l:L.GameLanguage}" Foreground="{StaticResource TextStrong}" Margin="0,20,0,0"/>
                <TextBlock Text="{x:Static l:L.GameLanguageHint}" Style="{StaticResource Caption}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="GameEnglishButton" Style="{StaticResource OutlineButton}" Content="English" MinWidth="96" Margin="0,0,8,0" Click="GameLanguage_Click"/>
                    <Button x:Name="GameRussianButton" Style="{StaticResource OutlineButton}" Content="Русский" MinWidth="96" Click="GameLanguage_Click"/>
                </StackPanel>

                <CheckBox x:Name="OnlyInWarframeCheckBox" Style="{StaticResource DarkCheckBox}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:L.OnlyInWarframe}"/>
                        <TextBlock Text="{x:Static l:L.OnlyInWarframeHint}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
