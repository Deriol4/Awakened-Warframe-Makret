<Window x:Class="AwakenedWarframeMarket.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Edge}"
            BorderThickness="1"
            TextElement.FontFamily="{StaticResource UiFont}"
            TextElement.FontSize="13"
            TextElement.Foreground="{StaticResource Text}">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top"
                    Height="36"
                    Background="{StaticResource TopBg}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource CaptionButton}"
                            ToolTip="Close without saving"
                            AutomationProperties.Name="Close"
                            Click="CancelButton_Click">
                        <Path Data="M2,2 L10,10 M10,2 L2,10" Width="12" Height="12"
                              Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <TextBlock Text="Settings" FontSize="12" Foreground="{StaticResource Soft}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource FooterBg}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlineButton}" Content="Cancel" Margin="0,0,8,0" Click="CancelButton_Click"/>
                    <Button Style="{StaticResource AccentButton}" Content="Save" Click="SaveButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Body -->
            <StackPanel Margin="18,18,18,20">
                <TextBlock Text="Price check hotkey" Foreground="{StaticResource TextStrong}"/>
                <TextBlock Text="Click the field and press a combination: Ctrl, Alt or Shift with a letter or digit, or an F-key"
                           Style="{StaticResource Caption}" Margin="0,2,0,8" TextWrapping="Wrap"/>

                <Button x:Name="HotkeyBox"
                        Height="38"
                        HorizontalContentAlignment="Left"
                        Padding="12,0"
                        Background="{StaticResource InputBg}"
                        Click="HotkeyBox_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}"/>
                    </Button.Style>
                    <TextBlock x:Name="HotkeyBoxText" Text="Ctrl + D" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"/>
                </Button>
                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                <CheckBox x:Name="OnlyInWarframeCheckBox" Style="{StaticResource DarkCheckBox}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Only while Warframe is in front"/>
                        <TextBlock Text="Other apps can use the same keys when you're not in the game" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </CheckBox>

                <CheckBox x:Name="DebugModeCheckBox" Style="{StaticResource DarkCheckBox}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Debug mode"/>
                        <TextBlock Text="Saves what was captured and read to the debug folder next to the app" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
