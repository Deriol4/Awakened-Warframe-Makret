<Window x:Class="AwakenedWarframeMarket.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Awakened Warframe Market"
        Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#1a1a1a">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="AWAKENED"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#d4af37"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="WARFRAME MARKET"
                       FontSize="14"
                       Foreground="#9e9e9e"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Status -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Background="#2a2a2a"
                    CornerRadius="8"
                    Padding="30,20"
                    BorderBrush="#333333"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="16"
                               Foreground="#4a9eff"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HotkeyText"
                               Text="Press Ctrl+D to check prices"
                               FontSize="12"
                               Foreground="#9e9e9e"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="InfoText"
                       Text="Hover over an item in Warframe and press the hotkey"
                       FontSize="11"
                       Foreground="#666666"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,15,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <Button x:Name="SettingsButton"
                    Content="Settings"
                    Style="{StaticResource ModernButton}"
                    Click="SettingsButton_Click"
                    Margin="0,0,10,0"/>
            <Button x:Name="MinimizeButton"
                    Content="Minimize to Tray"
                    Style="{StaticResource ModernButton}"
                    Click="MinimizeButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
